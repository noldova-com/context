{
  "name": "@noldova/context",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "24.21.0",
    "npm": "11.19.0"
  },
  "scripts": {
    "build": "(pipelines installed || npm ci --ignore-scripts) && pipelines build",
    "generate:regex-known-failures": "node src/parsers/noldova.context.parsers.regex/scripts/generate-known-failures.ts",
    "generate:typescript-diagnostics": "node src/parsers/noldova.context.parsers.typescript/scripts/generate-diagnostics.ts",
    "generate:typescript-expected-diagnostics": "node src/parsers/noldova.context.parsers.typescript/scripts/generate-expected-diagnostics.ts",
    "generate:typescript-known-failures": "node src/parsers/noldova.context.parsers.typescript/scripts/generate-known-failures.ts",
    "test": "pipelines test",
    "vendor:regex": "node src/parsers/noldova.context.parsers.regex/scripts/vendor-regex.ts",
    "vendor:typescript": "node src/parsers/noldova.context.parsers.typescript/scripts/vendor-typescript.ts"
  },
  "devDependencies": {
    "@noldova/tools.pipelines.github": "0.0.12",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
